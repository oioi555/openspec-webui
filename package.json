{
  "name": "openspec-webui",
  "version": "1.2.0",
  "description": "Local-first browser UI for exploring OpenSpec projects",
  "type": "module",
  "packageManager": "npm@11.19.0",
  "bin": {
    "openspec-webui": "./bin/openspec-webui.js"
  },
  "main": "./dist/cli/index.js",
  "scripts": {
    "dev": "node ./scripts/dev.mjs",
    "build": "node ./scripts/clean-dist.mjs && node ./scripts/compile-i18n.mjs && node ./scripts/run-local-bin.mjs tsc -p ./tsconfig.build.json && node ./scripts/run-local-bin.mjs vite build --config frontend/vite.config.ts",
    "test": "node ./scripts/test.mjs",
    "typecheck": "node ./scripts/compile-i18n.mjs && node ./scripts/run-local-bin.mjs tsc --noEmit && node ./scripts/run-local-bin.mjs svelte-check --tsconfig ./frontend/tsconfig.json",
    "prepublishOnly": "node ./scripts/verify-release.mjs"
  },
  "keywords": [
    "openspec",
    "viewer",
    "specification",
    "cli",
    "documentation"
  ],
  "author": "oioi555",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oioi555/openspec-webui.git"
  },
  "bugs": {
    "url": "https://github.com/oioi555/openspec-webui/issues"
  },
  "homepage": "https://github.com/oioi555/openspec-webui#readme",
  "engines": {
    "node": ">=20.19.0"
  },
  "files": [
    "README.md",
    "LICENSE",
    "ThirdPartyNotices.txt",
    "bin/",
    "dist/",
    "dist-frontend/"
  ],
  "dependencies": {
    "@fastify/static": "^10.1.3",
    "@fastify/websocket": "^11.3.0",
    "chokidar": "^5.0.0",
    "commander": "^15.0.0",
    "fastify": "^5.12.1",
    "open": "^11.0.1",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "^2.25.0",
    "@inlang/plugin-message-format": "^4.4.3",
    "@lucide/svelte": "^1.34.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.4.0",
    "@types/ws": "^8.18.1",
    "bits-ui": "^2.19.0",
    "clsx": "^2.1.1",
    "generate-license-file": "^4.2.4",
    "marked": "^18.0.11",
    "shadcn-svelte": "^1.5.1",
    "svelte": "^5.56.10",
    "svelte-check": "^4.7.6",
    "svelte-sonner": "^1.2.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "vite": "^8.2.2"
  }
}
